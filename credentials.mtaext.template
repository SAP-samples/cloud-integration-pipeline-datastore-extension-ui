_schema-version: 3.3.0
ID: datastore-extension-ui-credentials
extends: datastore-extension-ui

modules:
- name: datastore-extension-ui-srv
  properties:
    # Multi-Tenant Configuration (recommended)
    # Add one object per SAP Cloud Integration environment.
    # The YAML >- block scalar folds all lines into one string automatically.
    TENANTS_CONFIG: >-
      [
        {
          "id": "dev",
          "label": "DEV",
          "oauthUrl": "https://your-tenant-dev.authentication.eu10.hana.ondemand.com/oauth/token",
          "clientId": "sb-your-client-id-dev",
          "clientSecret": "your-client-secret-dev",
          "apiBaseUrl": "https://your-tenant-dev.it-cpi018-rt.cfapps.eu10.hana.ondemand.com/http/pipeline/api/v1"
        },
        {
          "id": "rte",
          "label": "RTE",
          "oauthUrl": "https://your-tenant-rte.authentication.eu10.hana.ondemand.com/oauth/token",
          "clientId": "sb-your-client-id-rte",
          "clientSecret": "your-client-secret-rte",
          "apiBaseUrl": "https://your-tenant-rte.it-cpi018-rt.cfapps.eu10.hana.ondemand.com/http/pipeline/api/v1"
        }
      ]
