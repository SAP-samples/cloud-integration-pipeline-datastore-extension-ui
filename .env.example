# Configure one or more SAP Cloud Integration tenants as a JSON array.
# Each entry requires: id, label, oauthUrl, clientId, clientSecret, apiBaseUrl
# For a single tenant, the array contains just one object.
# The entire value must be on a single line.
#
TENANTS_CONFIG=[{"id":"dev","label":"DEV","oauthUrl":"https://your-tenant-dev.authentication.eu10.hana.ondemand.com/oauth/token","clientId":"sb-your-client-id-dev","clientSecret":"your-client-secret-dev","apiBaseUrl":"https://your-tenant-dev.it-cpi018-rt.cfapps.eu10.hana.ondemand.com/http/pipeline/api/v1"},{"id":"rte","label":"RTE","oauthUrl":"https://your-tenant-rte.authentication.eu10.hana.ondemand.com/oauth/token","clientId":"sb-your-client-id-rte","clientSecret":"your-client-secret-rte","apiBaseUrl":"https://your-tenant-rte.it-cpi018-rt.cfapps.eu10.hana.ondemand.com/http/pipeline/api/v1"}]

