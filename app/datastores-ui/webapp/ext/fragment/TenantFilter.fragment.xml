<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Select
        id="tenantFilterSelect"
        width="180px"
        forceSelection="false"
        selectedKey="{tenantModel>/selectedTenantId}"
        change="datastoresui.ext.CustomActions.onTenantFilterChange"
        items="{
            path: 'tenantModel>/tenants',
            templateShareable: true
        }">
        <core:ListItem key="{tenantModel>id}" text="{tenantModel>label}" />
    </Select>
</core:FragmentDefinition>
